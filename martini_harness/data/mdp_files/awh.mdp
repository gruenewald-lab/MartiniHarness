define = -DTI
integrator               = sd
dt                       = 0.02
nsteps                   = 500000 ; 10 ns
nstcomm                  = 100
comm-grps		 = 

nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 100000
nstenergy                = 5000
nstxout-compressed       = 50000
compressed-x-precision   = 100
compressed-x-grps        = 


cutoff-scheme            = Verlet
nstlist                  = 20
;rlist                    = 1.2

verlet-buffer-tolerance  = -1
rlist                    = 1.35

coulombtype              = cutoff 
coulomb-modifier         = Potential-shift-verlet
rcoulomb                 = 1.1
epsilon_r                = 15   ; 2.5 (with polarizable water)
vdw_type                 = cutoff  
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1

gen-vel                  = no
tc-grps                  = System
tcoupl                   = v-rescale
tau_t                    = 1.0
ref_t                    = 298.15
; Pressure coupling      = 
Pcoupl                   = Parrinello-Rahman
tau_p                    = 12.0
compressibility          = 4.5e-5
ref_p         = 1.0

lincs-order              = 8
lincs-iter               = 2

free-energy 		 = yes		; turn on alchemistry 
couple-lambda0 		 = none		; no non-bonded interactions at lambda=0
couple-lambda1 		 = vdw		; only LJ on at lambda=1 (charges off in both states)
couple-moltype 		 = TOCOUPLE	; molecule whose interactions coupled to lambda
couple-intramol 	 = no		; no decoupling of bonded terms
			   		; thus lambda=0 corresponds to the molecule in vacuum
init-lambda-state 	 = 20		; we start sampling at lambda index 20 (see below)
			   		; the values below define the lambdas for the 21 windows
					; only LJ is decoupled
vdw_lambdas              = 1 0.95 0.9 0.85 0.8 0.75 0.7 0.65 0.6 0.55 0.5 0.45 0.4 0.35 0.3 0.25 0.2 0.15 0.1 0.05 0
calc-lambda-neighbors 	 = -1	     	; calculate energy differences to all neighbours 
sc_alpha 		 = 0.5		; soft-core interactions to avoid overlap issues ...
sc_sigma 		 = 0.3		; when the molecule is barely present ...
sc_power 		 = 1		; (LJ lambda is close to 0)
sc_coul 		 = no		;

awh 			 = yes		; enable AWH
awh-potential 		 = umbrella	; harmonic umbrella with Monte Carlo sampling
			   		; (must be used now with alchemistry)
awh-nstout 		 = 50000	; frequency of updating the edr file
awh-nbias 		 = 1		; we have 1 bias (lambda)
awh-nstsample 		 = 100		
awh-nsamples-update 	 = 10
awh1-error-init 	 = 10		; dictates initial convergence together with
			   		; awh1-dim1-diffusion
awh1-equilibrate-histogram = no		
awh1-target 		  = constant	; target distribution is flat
awh1-growth 		  = exp-linear	; we use the two-stage approach for convergence
awh1-ndim 		  = 1		 
awh1-dim1-coord-provider  = fep-lambda	; AWH uses alchemical reaction coordinate
awh1-dim1-coord-index 	  = 1		
awh1-dim1-start 	  = 0		; we sample lambdas from 0 to 20
awh1-dim1-end 		  = 20
awh1-dim1-diffusion 	  = 0.001	; sets the convergence together with awh1-error-init
